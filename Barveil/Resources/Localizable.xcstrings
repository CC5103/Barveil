      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ"
          }
        }
      }
    },
    "Automatic": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動"
          }
        }
      }
    },
    "Automatic control is off": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动控制已关闭"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動制御はオフです"
          }
        }
      }
    },
    "Automatic detection is off. Use the button below or your keyboard shortcut.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检测已关闭。请使用下方按钮或键盘快捷键。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動検出はオフです。下のボタンまたはキーボードショートカットを使います。"
          }
        }
      }
    },
    "Automatically hide the menu bar during full-screen playback.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏播放时自动隐藏菜单栏。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーン再生中はメニューバーを自動的に隠します。"
          }
        }
      }
    },
    "Barveil": {
      "extractionState": "manual"
    },
    "Barveil control": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Barveil 控制"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Barveil の制御"
          }
        }
      }
    },
    "Barveil gets the menu bar out of the way only while a video is playing full screen.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在视频全屏播放时，Barveil 才会让菜单栏暂时退场。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Barveil は動画がフルスクリーンで再生されている間だけ、メニューバーを邪魔にならない位置へ退けます。"
          }
        }
      }
    },
    "Barveil registers itself; macOS only asks you to confirm the system switch.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Barveil 会自动注册，macOS 只会请你确认系统开关。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Barveil は自動で登録されます。macOS ではシステムのスイッチを確認するだけです。"
          }
        }
      }
    },
    "Barveil Settings": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Barveil 设置"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Barveil 設定"
          }
        }
      }
    },
    "Barveil will be added to Accessibility automatically. You only need to turn on its system switch.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Barveil 会自动加入辅助功能列表，你只需要打开它的系统开关。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Barveil はアクセシビリティ一覧に自動で追加されます。システムのスイッチをオンにするだけです。"
          }
        }
      }
    },
    "Behavior": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {

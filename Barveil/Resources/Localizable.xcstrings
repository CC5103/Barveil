    "Launch at login": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时启动"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に起動"
          }
        }
      }
    },
    "Leave this off unless a player is not detected. It can produce more false positives.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在播放器无法识别时开启；它可能增加误判。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイヤーが検出されない場合だけオンにしてください。誤検出が増える可能性があります。"
          }
        }
      }
    },
    "Leaving full screen": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在退出全屏"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全画面から切り替え中"
          }
        }
      }
    },
    "Links": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {

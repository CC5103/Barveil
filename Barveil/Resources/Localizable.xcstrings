    "Hidden until the app changes": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换应用前保持隐藏"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを切り替えるまで非表示"
          }
        }
      }
    },
    "Hide Menu Bar": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏菜单栏"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーを隠す"
          }
        }
      }
    },
    "Hides the menu bar only when the front app is playing full-screen video. Windowed playback is left alone.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当前台 App 全屏播放视频时隐藏菜单栏；窗口播放不受影响。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前面のアプリがフルスクリーン動画を再生しているときだけメニューバーを隠します。ウインドウ再生には影響しません。"
          }
        }
      }
    },
    "Include This App": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消排除"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリを対象に戻す"
          }
        }
      }
    },
    "It will come back when playback pauses or the picture leaves full screen.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停播放或退出全屏后，它会自动回来。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生を一時停止するかフルスクリーンを終了すると、自動的に戻ります。"
          }
        }
      }
    },
    "Keep Hidden": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持隐藏"
          }

{
  "sourceLanguage": "en",
  "strings": {
    "%lld recorded events": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 条记录"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件の記録"
          }
        }
      }
    },
    "A manual toggle stays pinned until the front app changes. Automatic control then resumes.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动操作会保持到前台 App 改变；随后自动控制会恢复。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動操作は前面のアプリが変わるまで固定され、その後は自動制御に戻ります。"
          }
        }
      }
    },
    "A quieter full screen": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更安静的全屏体验"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もっと静かなフルスクリーン"
          }
        }
      }
    },
    "About": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "情報"
          }
        }
      }
    },
    "About Barveil": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于 Barveil"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Barveil について"
          }
        }
      }
    },
    "Accessibility": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ"
          }
        }
      }
    },
    "Accessibility access granted": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已获得辅助功能权限"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ権限は許可済みです"
          }
        }
      }
    },
    "Accessibility access not granted": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未获得辅助功能权限"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ権限が未許可です"
          }
        }
      }
    },
    "Active": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行中"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効"
          }
        }
      }
    },
    "Add Barveil & Open Settings": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 Barveil 并打开设置"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Barveil を追加して設定を開く"
          }
        }
      }
    },
    "Advanced": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
